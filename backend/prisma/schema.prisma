// ============================================================================
// Pharmacy Store Billing & Management — Prisma Schema (PostgreSQL)
// ============================================================================
// Design notes:
// - All monetary values use Decimal(12,2) to avoid floating point drift.
// - Soft-delete via `isActive` flags on master data (Drug, Customer, Doctor,
//   User) so historical bills/audit trails always resolve, even after a
//   record is retired.
// - Every write-heavy table that feeds the dashboard (Drug, Order) carries
//   indexes matched to the actual query patterns (expiry sweep, low-stock
//   sweep, text search, customer/doctor lookups).
// - "Smart search" (typing a generic/active ingredient or a symptom to find
//   branded drugs + substitutes) is implemented in the inventory service via
//   a raw SQL query against name/genericName/composition/symptoms using
//   ILIKE + Postgres full-text (to_tsvector/plainto_tsquery), combined with
//   the `substitutes`/`substituteFor` self-relation below. Standard b-tree
//   indexes on name/genericName keep the prefix/ILIKE paths fast; see
//   backend/prisma/manual-migrations/001_search_indexes.sql for the optional
//   trigram (pg_trgm) + GIN index upgrade for large catalogs.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  PHARMACIST
  BILLING_CLERK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STOCK_ADJUST
  ORDER_FINALIZE
  ORDER_VOID
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum OrderStatus {
  DRAFT
  FINALIZED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  INSURANCE
}

enum NotificationChannel {
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ----------------------------------------------------------------------------
// Auth & User Management
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(BILLING_CLERK)
  phone        String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs      AuditLog[]
  ordersCreated  Order[]         @relation("OrderCreatedBy")
  stockAdjustments StockAdjustment[]

  @@index([role])
  @@map("users")
}

/// Immutable trail of sensitive actions (inventory edits, billing, auth).
model AuditLog {
  id         String      @id @default(uuid())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  action     AuditAction
  entity     String // e.g. "Drug", "Order", "Customer"
  entityId   String?
  description String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Customer Management & Subscriptions
// ----------------------------------------------------------------------------

model Customer {
  id                String   @id @default(uuid())
  name              String
  phone             String   @unique
  email             String?
  age               Int?
  gender            String?
  address           String?
  chronicConditions String[] @default([]) // e.g. ["Diabetes", "Hypertension"]
  allergies         String[] @default([]) // e.g. ["Penicillin", "Sulfa"]
  loyaltyPoints     Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions   Subscription[]
  orders          Order[]
  loyaltyLedger   LoyaltyTransaction[]
  notifications   Notification[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

/// Recurring monthly refill tracking for chronic-condition patients.
model Subscription {
  id             String             @id @default(uuid())
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String
  drug           Drug               @relation(fields: [drugId], references: [id])
  drugId         String
  quantity       Int
  frequencyDays  Int                @default(30)
  lastRefillDate DateTime?
  nextDueDate    DateTime
  status         SubscriptionStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([customerId])
  @@index([nextDueDate, status]) // powers the "due for refill" alert sweep
  @@map("subscriptions")
}

/// Point-based loyalty ledger — every earn/redeem event is an immutable row,
/// customer.loyaltyPoints is a denormalized running balance for fast reads.
model LoyaltyTransaction {
  id          String   @id @default(uuid())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  String
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  points      Int // positive = earned, negative = redeemed
  reason      String
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@map("loyalty_transactions")
}

model Coupon {
  id             String     @id @default(uuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(12, 2) // percentage (0-100) or flat amount
  minOrderValue  Decimal?   @db.Decimal(12, 2)
  maxDiscount    Decimal?   @db.Decimal(12, 2)
  validFrom      DateTime
  validTo        DateTime
  usageLimit     Int?
  timesUsed      Int        @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  orders Order[]

  @@index([code])
  @@map("coupons")
}

// ----------------------------------------------------------------------------
// Drug Inventory Management
// ----------------------------------------------------------------------------

model Supplier {
  id      String  @id @default(uuid())
  name    String
  phone   String?
  email   String?
  address String?
  isActive Boolean @default(true)

  drugs Drug[]

  @@map("suppliers")
}

model Drug {
  id              String   @id @default(uuid())
  name            String // brand name, e.g. "Crocin 500mg"
  genericName     String // active ingredient, e.g. "Paracetamol"
  composition     String? // free-text composition/strength details
  symptoms        String[] @default([]) // e.g. ["fever", "headache", "pain"]
  manufacturer    String?
  category        String? // e.g. "Analgesic", "Antibiotic"
  batchNumber     String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  supplierId      String
  stockQuantity   Int      @default(0)
  reorderLevel    Int      @default(10) // "low stock" threshold
  costPrice       Decimal  @db.Decimal(12, 2)
  sellingPrice    Decimal  @db.Decimal(12, 2)
  gstPercent      Decimal  @default(12) @db.Decimal(5, 2)
  expiryDate      DateTime
  rackLocation    String? // e.g. "A-12-3"
  requiresRx      Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions     Subscription[]
  orderItems        OrderItem[]
  stockAdjustments  StockAdjustment[]

  // Substitute/alternative formulation linking (self-referencing M2M):
  // "this drug can be substituted by ->" and "is a substitute for <-"
  substitutes   Drug[] @relation("DrugSubstitutes")
  substituteFor Drug[] @relation("DrugSubstitutes")

  @@index([genericName])
  @@index([name])
  @@index([expiryDate]) // powers "expired drugs" dashboard sweep
  @@index([stockQuantity]) // powers "low stock" dashboard sweep
  @@index([supplierId])
  @@index([batchNumber])
  @@map("drugs")
}

/// Manual stock corrections (damage, returns, recount) — separate from
/// order-driven decrements so inventory movements stay fully auditable.
model StockAdjustment {
  id         String   @id @default(uuid())
  drug       Drug     @relation(fields: [drugId], references: [id], onDelete: Cascade)
  drugId     String
  delta      Int // positive = stock in, negative = stock out
  reason     String
  adjustedBy User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())

  @@index([drugId])
  @@map("stock_adjustments")
}

// ----------------------------------------------------------------------------
// Doctor Referral Tracking
// ----------------------------------------------------------------------------

model Doctor {
  id            String   @id @default(uuid())
  name          String
  speciality    String
  clinicAddress String?
  contactNumber String
  email         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  orders Order[] // orders referred by this doctor

  @@index([name])
  @@index([speciality])
  @@map("doctors")
}

// ----------------------------------------------------------------------------
// Billing & Order Management
// ----------------------------------------------------------------------------

model Order {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // human-readable sequence, e.g. INV-000123
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?
  referredByDoctor Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId        String?
  createdByUser   User          @relation("OrderCreatedBy", fields: [userId], references: [id])
  userId          String

  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyPointsUsed Int         @default(0)
  loyaltyDiscount Decimal       @default(0) @db.Decimal(12, 2)
  coupon          Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId        String?
  netTotal        Decimal       @db.Decimal(12, 2)

  paymentMethod   PaymentMethod @default(CASH)
  status          OrderStatus   @default(FINALIZED)

  items           OrderItem[]
  loyaltyEntries  LoyaltyTransaction[]
  notifications   Notification[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customerId])
  @@index([doctorId]) // referral metrics
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  drug        Drug     @relation(fields: [drugId], references: [id])
  drugId      String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) // snapshot of sellingPrice at sale time
  gstPercent  Decimal  @db.Decimal(5, 2) // snapshot of gst at sale time
  lineTotal   Decimal  @db.Decimal(12, 2) // quantity * unitPrice (pre-tax)

  @@index([orderId])
  @@index([drugId])
  @@map("order_items")
}

/// Mock SMS/WhatsApp invoice notification gateway log.
model Notification {
  id         String              @id @default(uuid())
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  channel    NotificationChannel @default(SMS)
  recipient  String // phone number
  message    String
  invoiceUrl String?
  status     NotificationStatus  @default(SENT)
  createdAt  DateTime            @default(now())

  @@index([orderId])
  @@map("notifications")
}
